generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model YogaPose {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  sanskritName String?
  description  String
  benefits     String[]
  instructions String[]
  difficulty   Difficulty @default(BEGINNER)
  focusArea    String
  imageUrl     String?
  videoUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}